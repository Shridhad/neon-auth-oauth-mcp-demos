{
  "name": "@neon/oauth-client",
  "version": "0.0.0",
  "private": true,
  "description": "Internal OAuth helpers for apps built on Neon Auth (client login, resource-server token verification, MCP server auth).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./adapter": {
      "types": "./dist/adapters/core.d.ts",
      "default": "./dist/adapters/core.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "default": "./dist/adapters/hono.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0",
    "hono": ">=4.0.0",
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.10.5",
    "hono": "4.13.8",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "express": "5.1.0",
    "@types/express": "5.0.3"
  }
}
