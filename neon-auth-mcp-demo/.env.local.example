# Base URL of your local neon-auth instance. Paste the ROOT endpointId and
# database name (usually `neondb`) from the Neon project you're running
# neon-auth against locally. Local neon-auth serves TLS on :30443 with a
# self-signed cert (see NODE_TLS_REJECT_UNAUTHORIZED note in the README).
NEON_AUTH_BASE_URL=https://<root-endpointId>.neonauth.localtest.me:30443/neondb/auth

# Secret used to sign the session-data cache cookie. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Least-privilege role: read/write public.todos only.
TODOS_DATABASE_URL=<your-todos-db-connection-string>
